# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit Text Formats
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.html text
*.css text
*.md text
*.webmanifest text
*.env.example text
*.rules text

# Explicit Binary Formats (Preserve exact byte-for-byte raw data without transformation)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text
*.mp4 binary
*.webm binary
*.mov binary
*.m4v binary
*.mp3 binary
*.wav binary
*.ogg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary
